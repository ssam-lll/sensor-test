    {
        "id": "fn_build_motor_cmd",
        "type": "function",
        "z": "tab_telemetria",
        "name": "Formatear Comando Motores",
        "func": "context.m1 = context.m1 || 0;\ncontext.m2 = context.m2 || 0;\n\nif (msg.topic === 'stop') {\n    context.m1 = 0;\n    context.m2 = 0;\n    return { payload: { cmd: 'stop', m1: 0, m2: 0 } };\n}\n\nif (msg.topic === 'm1') {\n    let v1 = parseInt(msg.payload) || 0;\n    context.m1 = (Math.abs(v1) <= 10) ? 0 : v1;\n}\nif (msg.topic === 'm2') {\n    let v2 = parseInt(msg.payload) || 0;\n    context.m2 = (Math.abs(v2) <= 10) ? 0 : v2;\n}\n\nreturn {\n    payload: {\n        cmd: 'set_motores',\n        m1: context.m1,\n        m2: context.m2\n    }\n};",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
