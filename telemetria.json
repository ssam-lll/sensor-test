        ]
    },
    {
        "id": "fn_preparar_select",
        "type": "function",
        "z": "tab_telemetria",
        "name": "Preparar SELECT",
        "func": "if (!msg.lectura || !msg.payload || msg.payload.affectedRows < 1) {\n    return null;\n}\n\n// Devuelve cada sensor como mensaje individual para alimentar el grafico y el gauge\nreturn [msg.lectura.map(item => ({\n    topic: item.sensor,\n    payload: item.valor\n}))];",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 200,
