                "fn_preparar_select"
            ]
        ]
    },
    {
        "id": "fn_preparar_select",
        "type": "function",
        "z": "tab_telemetria",
        "name": "Preparar SELECT y Estado Barra",
        "func": "if (!msg.lectura || !msg.payload || msg.payload.affectedRows < 1) {\n    return null;\n}\n\nconst serie = msg.lectura.map(item => ({\n    topic: String(item.sensor).toUpperCase(),\n    payload: item.valor\n}));\n\nconst valores = msg.lectura.map(item => Math.round(item.valor));\nlet sumaPonderada = 0;\nlet sumaActiva = 0;\nlet maxVal = 0;\n\nfor (let i = 0; i < valores.length; i++) {\n    const v = valores[i];\n    if (v > maxVal) maxVal = v;\n    if (v > 500) {\n        sumaPonderada += v * (i * 1000);\n        sumaActiva += v;\n    }\n}\n\nlet posicion = 0;\nlet zona = \"SIN LINEA\";\nif (sumaActiva > 0 && maxVal > 500) {\n    posicion = Math.round((sumaPonderada / sumaActiva) - 3500);\n    if (posicion < -600) {\n        zona = \"IZQUIERDA\";\n    } else if (posicion > 600) {\n        zona = \"DERECHA\";\n    } else {\n        zona = \"CENTRO\";\n    }\n}\n\nconst estadoBarra = {\n    payload: {\n        valores: valores,\n        posicion: posicion,\n        zona: zona,\n        maxVal: maxVal\n    }\n};\n\nreturn [serie, estadoBarra];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 810,
        "y": 200,
        "wires": [
            [
                "231de22833a3c5df",
                "aec95a55bf6512d2"
            ],
            [
                "ui_template_barra"
            ]
        ]
    },
