    {
        "id": "fn_preparar_insert",
        "type": "function",
        "z": "tab_telemetria",
        "name": "Preparar INSERT",
        "func": "const data = msg.payload;\n\nif (!data) return null;\n\nif (data.error && data.error !== 0) {\n    return [null, { payload: \"Error en el sensor: codigo \" + data.error }];\n}\n\nlet lecturas = [];\nif (Array.isArray(data.sensores)) {\n    lecturas = data.sensores.map((val, idx) => ({ sensor: 'S' + idx, valor: parseFloat(val) }));\n} else if (data.sensor && data.valor !== undefined) {\n    lecturas = [{ sensor: String(data.sensor), valor: parseFloat(data.valor) }];\n} else {\n    return [null, { payload: \"Formato de telemetria no valido\" }];\n}\n\nlet placeholders = [];\nlet params = [];\nfor (let i = 0; i < lecturas.length; i++) {\n    placeholders.push(\"(?, ?)\");\n    params.push(lecturas[i].sensor, lecturas[i].valor);\n}\n\nconst query = \"INSERT INTO telemetria (sensor, valor) VALUES \" + placeholders.join(\", \") + \";\";\n\nconst dbMsg = {\n    topic: query,\n    payload: params,\n    lectura: lecturas\n};\n\nreturn [dbMsg, null];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 200,
        "wires": [
            [
                "node_mysql_db"
            ],
            [
                "c0c5693c251dd862"
            ]
        ]
    },
    {
        "id": "node_mysql_db",
        "type": "mysql",
        "z": "tab_telemetria",
        "mydb": "71503c337fadd464",
        "name": "telemetria_iot",
        "x": 580,
        "y": 200,
        "wires": [
