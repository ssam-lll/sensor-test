    {
        "id": "sub_sensores",
        "type": "mqtt in",
        "z": "tab_telemetria",
        "name": "infrarrojo",
        "topic": "telemetria/sensores",
        "qos": "2",
        "datatype": "json",
        "broker": "mqtt_broker_local",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
