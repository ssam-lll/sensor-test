    {
        "id": "ui_template_barra",
        "type": "ui_template",
        "z": "tab_telemetria",
        "group": "1c8f99ae2553855b",
        "name": "Matriz Numerica 8CH",
        "order": 2,
        "width": 6,
        "height": 3,
        "format": "<div style=\"font-family: monospace; padding: 4px;\">\n  <div style=\"display: grid; grid-template-columns: repeat(8, 1fr); gap: 4px; text-align: center;\">\n    <div ng-repeat=\"val in msg.payload.valores track by $index\"\n         style=\"border: 1px solid #555; border-radius: 4px; padding: 6px 2px; background-color: {{ val > 1800 ? '#1e293b' : '#f8fafc' }}; color: {{ val > 1800 ? '#f8fafc' : '#0f172a' }};\">\n      <div style=\"font-size: 10px; opacity: 0.75;\">S{{$index}}</div>\n      <div style=\"font-size: 12px; font-weight: bold;\">{{val}}</div>\n    </div>\n  </div>\n  <div style=\"margin-top: 8px; padding: 6px; border-radius: 4px; background: #0f172a; color: #e2e8f0; text-align: center; font-size: 12px;\">\n    <span>Posición: <strong>{{msg.payload.posicion || 0}}</strong></span>\n    <span style=\"margin-left: 12px;\">Zona: <strong>{{msg.payload.zona || 'ESPERANDO'}}</strong></span>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
