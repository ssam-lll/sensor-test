    {
        "id": "fn_secuencia_test",
        "type": "function",
        "z": "tab_telemetria",
        "name": "Orquestar Secuencia de Prueba",
        "func": "node.send({ payload: { cmd: 'set_motores', m1: 180, m2: 0 } });\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'stop', m1: 0, m2: 0 } });\n}, 400);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'set_motores', m1: -180, m2: 0 } });\n}, 550);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'stop', m1: 0, m2: 0 } });\n}, 950);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'set_motores', m1: 0, m2: 180 } });\n}, 1100);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'stop', m1: 0, m2: 0 } });\n}, 1500);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'set_motores', m1: 0, m2: -180 } });\n}, 1650);\n\nsetTimeout(() => {\n    node.send({ payload: { cmd: 'stop', m1: 0, m2: 0 } });\n}, 2050);\n\nreturn null;",
